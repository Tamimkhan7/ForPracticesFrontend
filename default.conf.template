server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # product uploads can be big
    client_max_body_ize 50m;

    # Docker's built-in DNS (works on a user-defined network like appnet)
    resolver 127.0.0.11 valid=10s ipv6=off;

    # API calls  ->  backend container
    location /api/ {
        set $backend ${BACKEND_URL};
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # uploaded product files  ->  backend container
    location /uploads/ {
        set $backend ${BACKEND_URL};
        proxy_pass $backend;
        proxy_set_header Host $host;
    }

    # React Router: any other path serves index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
